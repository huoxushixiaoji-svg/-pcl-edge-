{
  "manifest_version": 3,
  "name": "PCL 百宝箱下载助手",
  "version": "0.1.2",
  "description": "将普通 HTTP/HTTPS 下载交给本机 PCL 百宝箱的多线程下载引擎。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "PCL 下载助手",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
