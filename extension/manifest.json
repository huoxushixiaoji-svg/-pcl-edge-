{
  "manifest_version": 3,
  "name": "Edge 独立多线程下载助手",
  "version": "0.3.0",
  "description": "将普通 HTTP/HTTPS 下载交给独立本机多线程下载器。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications",
    "contextMenus",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "独立下载助手",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
